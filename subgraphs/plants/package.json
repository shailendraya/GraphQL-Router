{
  "name": "users",
  "version": "1.0.0",
  "description": "Users sub graph for plants-site",
  "main": "server.js",
  "scripts": {
    "test": "jest",
    "generate": "graphql-codegen",
    "build": "npm run generate && tsc --build tsconfig.build.json && npm run schema:copy-files",
    "schema:copy-files": "shx cp ./src/graphql/*.graphql ./dist/graphql",
    "schema:output": "node -e 'require(\"./dist/utils/schema\").writeSchema()'",
    "start:dev": "nodemon --watch \"src/**\" --ext \"ts,json,graphql\" --exec \"npm run build && npm run start\" --ignore ./__generated__/  --ignore mocks/ ",
    "start": "node dist/server.js"
  },
  "keywords": [],
  "author": "Deepak Jha",
  "license": "ISC",
  "dependencies": {
    "@apollo/subgraph": "^2.8.0",
    "@graphql-mesh/cli": "^0.92.1",
    "@graphql-mesh/openapi": "^0.102.0",
    "@types/node": "^22.0.0",
    "apollo-server": "^3.13.0",
    "common": "workspace:^",
    "graphql": "^16.8.2",
    "graphql-cost-analysis": "^1.0.3",
    "graphql-depth-limit": "^1.1.0",
    "graphql-middleware": "^6.1.35",
    "graphql-query-complexity": "^0.12.0",
    "graphql-shield": "^7.6.5",
    "graphql-tag": "^2.12.6",
    "path": "^0.12.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.7",
    "@graphql-codegen/typescript-resolvers": "^4.1.0",
    "@types/jest": "^29.6.4",
    "jest": "^29.6.4",
    "ts-jest": "^29.1.0",
    "nodemon": "^3.1.3",
    "shx": "^0.3.4",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  }
}
